# Deployer wallet. NEVER commit the real one.
PRIVATE_KEY=0x...
# Address allowed to settle Fridays (can be the deployer at first)
KEEPER=0x...
# Mint price in wei = $5 at today's ETH price (e.g. 0.0013 ether at $3,800 → 1300000000000000)
MINT_PRICE_WEI=1300000000000000
# sha256 provenance of the 1,000 base images: "provenance" in collection/collection.json, 0x-prefixed
PROVENANCE=0x...
# Renderer; tokenURI = BASE_URI + id
BASE_URI=https://api.hoodochi.io/token/
